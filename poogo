#!/usr/bin/env bash
## 💩 Hugo's stinky step-child who won't stop putting his mark down!
# shellcheck disable=SC2164

set -euo pipefail
shopt -s nullglob

pushd() { command pushd "$@" >/dev/null || exit 1; }
popd() { command popd >/dev/null || exit 1; }

err_msg() {
  echo "$1" && exit 1
}

# Escape special XML characters in a string
xml_escape() {
  local s="$1"
  s="${s//&/\&amp;}"
  s="${s//</\&lt;}"
  s="${s//>/\&gt;}"
  s="${s//\"/\&quot;}"
  s="${s//\'/\&apos;}"
  printf '%s' "$s"
}

bootstrap() {
  [[ -d "$TARGET" ]] && err_msg "Target bootstrap directory ($TARGET) already exists"
  echo "Bootstrapping into $TARGET"
  mkdir -p "$TARGET"
  pushd "$TARGET"
  mkdir posts/ && mkdir about/
  printf "# About me\n\nThis is a nice thing about me." >about/index.md
  printf "# My Blog Title\n\nThis is my blog.\n### Posts\n\n%%POSTS%%" >index.md
  printf "# My Blog\n\n[Home](/index.html)\n[Posts](/posts/index.html)\n[About](/about/index.html)" >header.md
  printf "This is my blog footer" >footer.md
  mkdir -p ~/.config/poogo
  printf "%s\n" "SITE_URL=https://example.com" "GH_TOKEN=" >~/.config/poogo/config.env
  chmod 600 ~/.config/poogo/config.env
  printf "%s\n" "config.env" "*.body.html" >.gitignore
  echo "Downloading Simple CSS"
  mkdir static/
  wget --quiet -O static/style.css "https://raw.githubusercontent.com/kevquirk/simple.css/main/simple.css"
}

# Pull "<!-- raw -->...<!-- endraw -->" blocks out of a markdown file so they
# bypass the GitHub markdown API's HTML sanitizer (which strips class/style/etc).
# Each block is written to "$2/raw.N" and replaced with a POOGORAWBLOCKN
# placeholder paragraph. Prints the placeholdered markdown to stdout.
extract_raw() {
  awk -v dir="$2" '
    BEGIN { n = 0; inraw = 0 }
    /^[[:space:]]*<!--[[:space:]]*raw[[:space:]]*-->[[:space:]]*$/ {
      inraw = 1; rawfile = dir "/raw." n
      print "\nPOOGORAWBLOCK" n "\n"
      next
    }
    /^[[:space:]]*<!--[[:space:]]*endraw[[:space:]]*-->[[:space:]]*$/ {
      if (inraw) { close(rawfile); inraw = 0; n++; next }
    }
    { if (inraw) print > rawfile; else print }
  ' "$1"
}

# Re-insert the blocks pulled by extract_raw, replacing each placeholder line
# (the API wraps it as <p>POOGORAWBLOCKN</p>) with the original raw HTML.
restore_raw() {
  awk -v dir="$2" '
    match($0, /POOGORAWBLOCK[0-9]+/) {
      f = dir "/raw." substr($0, RSTART + 13, RLENGTH - 13)
      while ((getline line < f) > 0) print line
      close(f); next
    }
    { print }
  ' "$1"
}

# Convert md file to html without extra html tags
# $1 - markdown file
# $2 - output file (defaults to <basename>.html)
# $3 - force generate if 1
md_to_html() {
  local auth_header filename out force tmpdir
  filename=${1%.md*}
  out="${2:-$filename.html}"
  force="${3:-0}"
  [[ ! -f $1 || $1 -ot "$out" && $force -ne 1 ]] && return 1
  printf "Converting %s to HTML..." "$(realpath "$filename.md")"
  [[ -n "$GH_TOKEN" ]] && auth_header=(--header "Authorization: Bearer $GH_TOKEN")
  tmpdir=$(mktemp -d)
  extract_raw "$1" "$tmpdir" |
    jq --slurp --raw-input '{"text": "\(.)", "mode": "markdown"}' |
    curl -s \
      "${auth_header[@]}" \
      --data @- https://api.github.com/markdown >"$tmpdir/out.html" ||
    { rm -rf "$tmpdir"; err_msg "Couldn't generate HTML using GH API."; }
  restore_raw "$tmpdir/out.html" "$tmpdir" >"$out"
  rm -rf "$tmpdir"
}

# Convert md file to full html page
md_to_html_page() {
  local filename title body regenerated=0
  filename=${1%.md*}
  body="$filename.body.html" # cached API-converted body, reused on header/footer changes
  title=$(xml_escape "$(extract_title "$1")")

  # Re-convert the markdown body via the API only when the source changed.
  md_to_html "$1" "$body" || regenerated=1

  # Reassemble the page when the body, header, or footer is newer than it;
  # a header/footer change only re-wraps the cached body (no API call).
  [[ $regenerated -ne 0 &&
    -f "$filename.html" &&
    ! "$filename.html" -ot "$HEADER" &&
    ! "$filename.html" -ot "$FOOTER" ]] && return 1

  printf "...and creating HTML page...\n"
  printf "<!DOCTYPE html>
          <head>
            <meta charset=\"UTF-8\">
            <link rel=\"shortcut icon\" type=\"image/png\" href=\"/favicon.png\">
            <link rel=\"stylesheet\" href=\"%s\">
            <title>%s</title>
          </head>
          <body>
          %s
            %s
            %s
            %s
          </body>
          </html>" \
    "$CSS" \
    "$title" \
    "<header>$(<"${HEADER:-/dev/null}")</header>" \
    "$(<"$body")" \
    "<footer>$(<"${FOOTER:-/dev/null}")</footer>" \
    "$THEME_SWITCHER_TAG" >"$filename.html"
}

extract_title() {
  s='/# .*/{s/# (.*)/\1/p;Q};q1' # return 1 on a non-match
  sed -rn "$s" "$1" || sed -rn "$s" "$HEADER_MD"
}

extract_ts() {
  sed -rn 's/<!-- %TIMESTAMP=([[:digit:]]*)% -->/\1/p' "$1"
}

# Return 0 if the markdown file is marked as a draft, 1 otherwise.
is_draft() {
  grep -q '<!-- %DRAFT% -->' "$1"
}

generate_posts() {
  pushd posts/
  ALL_POSTS=()            # set of posts to show on /posts/index.html
  REGEN_POSTS_INDEX=0     # whether or not we should regen /index.html and /post/index.html
  for md in *.md; do
    is_draft "$md" && continue # skip drafts
    local title timestamp filename link
    filename=${md%.md*}
    title=$(extract_title "$md")
    timestamp=$(extract_ts "$md")
    link="[$title](/posts/$filename.html)<br>"
    ALL_POSTS+=("$timestamp $link")
    if md_to_html_page "$md"; then
      REGEN_POSTS_INDEX=1
    fi
  done
  # HACK: need to run if /index.html will be generated
  if [[ ! -f index.html ||
    ! -f ../index.html ||
    ../index.md -nt ../index.html ||
    $REGEN_POSTS_INDEX -eq 1 ]]; then
    # sort posts by timestamp and format timestamp
    readarray -t ALL_POSTS < <(
      while read -r ts title; do
        printf "<tt>%s  </tt> %s\n" "$(date -d "@$ts" "+%d %b %Y")" "$title" |
          tee -a index.md
      done < <(printf "%s\n" "${ALL_POSTS[@]}" | sort -nr -k1)
    )
    md_to_html_page index.md
    rm index.md
    REGEN_POSTS_INDEX=1
  fi
  popd
}

generate() {
  # shellcheck disable=SC1091,SC1090
  source ~/.config/poogo/config.env
  [[ ! -d posts ]] && err_msg "Posts directory not found."

  # Prepare header/footer and CSS
  md_to_html header.md || true
  md_to_html footer.md || true
  HEADER_MD=$(realpath "./header.md")
  HEADER=$(realpath "./header.html")
  FOOTER=$(realpath "./footer.html")
  CSS="/static/style.css"
  THEME_SWITCHER_TAG=""
  if [[ -f static/theme-switch.js ]]; then
    THEME_SWITCHER_TAG="          <script defer src=\"/static/theme-switch.js\"></script>"
  fi

  local gen_posts
  local gen_about=0

  generate_posts
  gen_posts=$REGEN_POSTS_INDEX
  if [[ $gen_posts -eq 1 ||
    index.md -nt index.html ||
    "$HEADER" -nt index.html ||
    "$FOOTER" -nt index.html ]]; then
    # Add posts section to root index.html
    sed "s;%POSTS%;${ALL_POSTS[*]:0:6};" index.md >index.md.tmp
    md_to_html_page index.md.tmp
    rm index.md.tmp
  fi

  if md_to_html_page about/index.md; then
    gen_about=1
  fi

  if [[ ! -f rss.xml || $gen_posts -eq 1 || $gen_about -eq 1 ]]; then
    echo "Generating rss.xml..."
    generate_rss >rss.xml
  fi
}

post_to_rss_item() {
  local filename title link guid pub_date
  filename=${1%.md*}
  html=${1/.md*/.html}
  title=$(xml_escape "$(extract_title "$1")")
  link="$SITE_URL/$filename.html"
  guid="$link"
  pub_date=$(date -R -d "@$(extract_ts "$1")")

  # sed replaces relative paths (starting with /) with an absolute path
  printf '<item>
<title>%s</title>
<guid>%s</guid>
<link>%s</link>
<pubDate>%s</pubDate>
<description><![CDATA[%s
]]></description>
</item>' "$title" "$guid" "$link" "$pub_date" \
    "$(xmllint --html --xpath "//body/*[not(self::header or self::footer)]" "$html" 2>/dev/null | sed -E "s;(<a href=\")/([^\"]+)(\");\1$SITE_URL/\2\3;g")"
}

generate_rss() {
  local title description
  title=$(xml_escape "$(sed -rn 's/# (.*)/\1/p;q' header.md)")
  description=$(xml_escape "$(head -n 1 index.md)")

  printf '<?xml version="1.0" encoding="utf-8"?>
<?xml-stylesheet type="text/css" href="rss.css" ?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">

<channel>
<title>%s</title>
<description>%s</description>
<language>en-us</language>
<link>%s/rss.xml</link>
<atom:link href="%s/rss.xml" rel="self" type="application/rss+xml" />

%s

</channel>
</rss>' \
    "$title" "$description" "$SITE_URL" "$SITE_URL" "$(
      for post in posts/*.md; do
        is_draft "$post" && continue # skip drafts
        post_to_rss_item "$post"
      done
    )"
}

usage() {
  echo "poogo - a static-site generator for blogs."
  echo "Usage:  poogo -b [-p PATH] - bootstrap a skeleton blog"
  echo "        poogo -g [-p PATH] - generate HTML from Markdown files"
  echo "        poogo -n [-p PATH] - create new post"
}

check_command() {
    if ! command -v "$1" >/dev/null 2>&1
    then
        echo "$1 could not be found. Please install it."
        exit 1
    fi
}

required_commands=("curl" "sed" "xmllint" "jq" "wget" "awk" "mktemp")

for cmd in "${required_commands[@]}"; do
    check_command "$cmd"
done

BOOTSTRAP=""
GENERATE=""
NEW=""
TARGET="."

while getopts "bghn:p:" opt; do
  case "${opt}" in
    b)
      BOOTSTRAP=1
      ;;
    g)
      GENERATE=1
      ;;
    n)
      NEW=${OPTARG}
      ;;
    p)
      TARGET=${OPTARG}
      pushd "$TARGET"
      ;;
    h | *)
      usage && exit 1
      ;;
  esac
done

[[ -n "$BOOTSTRAP" ]] &&
  bootstrap && exit 0

[[ -n "$NEW" ]] &&
  (printf "# %s\n<!-- %%TIMESTAMP=%s%% -->" "${NEW^}" "$(date "+%s")" >"posts/${NEW// /_}.md" ||
    err_msg "Couldn't write new post. Maybe $TARGET/posts/ doesn't exist?")

[[ -n "$GENERATE" ]] &&
  generate
